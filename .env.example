# ---- Server ----
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Firebase Admin SDK ----
# Option A (recommended for local dev): point to a service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: inline credentials (useful for Cloud Run / CI secrets), all three required if used
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Firestore / Auth Emulators (local dev only) ----
# Uncomment to run against the Firebase emulator suite instead of production Firebase
# FIRESTORE_EMULATOR_HOST=localhost:8081
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ---- Gemini (structured JD parsing + failure classification; backend-only) ----
# Backend-only. Never expose this to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
